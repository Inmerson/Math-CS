    "autoprefixer": "^10.4.24",
    "framer-motion": "^12.23.24",
    "katex": "0.16.9",
    "lucide-react": "^0.554.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.1.3",
    "jsdom": "^28.0.0",
    "typescript": "~5.8.2",
